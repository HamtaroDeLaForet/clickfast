# Copier en .env et remplacer les valeurs : cp .env.example .env
# Le .env n'est jamais commité.

# Base PostgreSQL (lue par Postgres, l'API de scores et stats-api)
DB_USER=clickfast
DB_PASSWORD=change-moi
DB_NAME=clickfast

# Ports publiés sur l'hôte (la base n'en publie aucun)
FRONT_PORT=8080
# Le jeu appelle l'API sur le port 3000 (config.js) : changer les deux ensemble
API_PORT=3000
STATS_PORT=5000
ADMINER_PORT=8081

# Version des images publiées, utilisée par docker-compose.prod.yml
TAG=1.0.0
